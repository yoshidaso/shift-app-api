FROM golang:1.24

# ワークディレクトリの設定
WORKDIR /app

# air のインストール（ホットリロード）
ENV PATH="$PATH:/go/bin"
RUN go install github.com/air-verse/air@latest

# 依存関係を先に解決してキャッシュを効かせる
COPY go.mod go.sum ./
RUN go mod download

# アプリケーションのソースをコピー
COPY . .

# 公開ポート
EXPOSE 8080

# air のデフォルト設定で実行（.air.toml があれば自動で読み込まれます）
CMD ["air"]

